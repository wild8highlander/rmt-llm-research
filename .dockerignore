# =============================================================================
# .dockerignore — files excluded from the Docker build context.
# Reduces build time and image size by preventing large/unnecessary files
# from being sent to the Docker daemon.
# =============================================================================
# Keep this list in sync with .gitignore where applicable.

# ─── Version control ────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ─── Python caches & build artifacts ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# ─── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/
.python-version

# ─── Node.js ────────────────────────────────────────────────────────────────
node_modules/
laboratory/webapp/node_modules/
laboratory/webapp/dist/
laboratory/webapp/.vite/
npm-debug.log*
yarn-error.log*

# ─── Julia ──────────────────────────────────────────────────────────────────
julia/RMTLLMVerify/Manifest.toml
julia/RMTLLMViz/Manifest.toml
**/.ipynb_checkpoints/

# ─── IDE / editor ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ─── Generated outputs (regenerated inside container) ──────────────────────
laboratory/results/
laboratory/python/lab_en/results/
laboratory/python/lab_ru/results/
results/
docs/site/assets/

# ─── Docker themselves ──────────────────────────────────────────────────────
Dockerfile
.dockerignore
docker-compose.yml
.docker/

# ─── Documentation that bloats the image ────────────────────────────────────
docs/en/*.docx
docs/ru/*.docx
papers/*.pdf

# ─── Notebooks (can be mounted as volume instead) ───────────────────────────
notebooks/.ipynb_checkpoints/

# ─── Large trained weights (regenerated by `make tinygpt-train`) ────────────
laboratory/python/lab_en/results/models/*.npz
laboratory/python/lab_ru/results/models/*.npz

# ─── CI / metadata not needed at runtime ────────────────────────────────────
.zenodo.json
CODE_OF_CONDUCT.md
CONTRIBUTING.md
CHANGELOG.md
ARCHITECTURE.md
SECURITY.md
AUTHORS.md
CITATION.cff
LICENSE-CC-BY-NC-SA-4.0-HISTORICAL.txt
.all-contributorsrc
.editorconfig
.markdownlint.json
.markdown-link-check.json
.pre-commit-config.yaml
Makefile
codespellignore
