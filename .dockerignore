# =============================================================================
# .dockerignore — files excluded from the Docker build context.
# Reduces build time and image size by preventing large/unnecessary files
# from being sent to the Docker daemon.
# =============================================================================
# Keep this list in sync with .gitignore where applicable.
# The context is ~250 MB with these rules (was ~2.6 GB before neural_lab
# was excluded — the 2.4 GB model archives belong to the research kit, not
# the container image; mount them with:
#   docker run -v ./neural_lab:/workspace/neural_lab ...   (or via compose).

# ─── Version control ────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ─── Python caches & build artifacts ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
site-build/
.benchmarks/

# ─── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/
.python-version

# ─── Node.js ────────────────────────────────────────────────────────────────
node_modules/
laboratory/webapp/node_modules/
laboratory/webapp/dist/
laboratory/webapp/.vite/
npm-debug.log*
yarn-error.log*

# ─── Julia manifests (generated at instantiate time, never committed) ───────
laboratory/julia/julia/RMTLLMVerify/Manifest.toml
laboratory/julia/julia/RMTLLMViz/Manifest.toml
**/.ipynb_checkpoints/

# ─── IDE / editor ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ─── Generated outputs (regenerated inside container) ──────────────────────
laboratory/results/
laboratory/python/lab_en/results/
laboratory/python/lab_ru/results/
results/
docs/site/

# ─── neural_lab: 2.4 GB of model archives + research kits ────────────────────
# Trained-model split archives (Gemma3 / MNN-Pocket), RCDA research rounds
# and their reports are research DATA, not runtime dependencies. Mount them
# from the host when needed; do not bake them into the image.
neural_lab/

# ─── Docker themselves ──────────────────────────────────────────────────────
Dockerfile
.dockerignore
docker-compose.yml
.docker/

# ─── Documentation that bloats the image ────────────────────────────────────
# Monograph DOCX twins (24 files, up to 14 MB each) and merged papers PDF;
# the HTML site itself is built by `mkdocs build`, not shipped as sources.
docs/monographs/**/*.docx
docs/monographs/**/*.pdf

# ─── Notebooks checkpoints ──────────────────────────────────────────────────
notebooks/.ipynb_checkpoints/

# ─── Large trained weights (regenerated by `make tinygpt-train`) ────────────
laboratory/python/lab_en/results/models/*.npz
laboratory/python/lab_ru/results/models/*.npz

# ─── CI / metadata not needed at runtime ────────────────────────────────────
.zenodo.json
CODE_OF_CONDUCT.md
CONTRIBUTING.md
CHANGELOG.md
ARCHITECTURE.md
SECURITY.md
AUTHORS.md
CITATION.cff
.all-contributorsrc
.editorconfig
.markdownlint-cli2.jsonc
.markdown-link-check.json
.pre-commit-config.yaml
Makefile
.codespellignore
