// markdownlint-cli2 configuration
// https://github.com/DavidAnson/markdownlint-cli2#configuration
// Note: all lint rules live here (not in .markdownlint.json) so that the
// per-glob "overrides" below actually apply (rules in .markdownlint.json
// would take precedence and silently disable overrides).
{
  "config": {
    "default": true,
    "MD001": {
      "level": 1
    },
    "MD003": {
      "style": "atx"
    },
    "MD004": {
      "style": "dash"
    },
    "MD005": true,
    "MD007": {
      "indent": 2
    },
    "MD009": true,
    "MD010": true,
    "MD012": {
      "maximum": 1
    },
    "MD013": false,
    "MD014": false,
    "MD018": true,
    "MD019": false,
    "MD022": true,
    "MD023": true,
    "MD024": {
      "siblings_only": true
    },
    "MD025": {
      "front_matter_title": ""
    },
    "MD026": {
      "punctuation": ".,;:!"
    },
    "MD027": true,
    "MD028": true,
    "MD029": {
      "style": "ordered"
    },
    "MD030": {
      "ul": "one",
      "ol": "one"
    },
    "MD031": true,
    "MD032": true,
    "MD033": {
      "allowed_elements": [
        "img",
        "br",
        "hr",
        "sub",
        "sup",
        "kbd",
        "details",
        "summary",
        "b",
        "code",
        "p",
        "a",
        "sub"
      ]
    },
    "MD034": false,
    "MD035": {
      "style": "---"
    },
    "MD036": false,
    "MD037": true,
    "MD038": true,
    "MD039": true,
    "MD040": {
      "language_only": false
    },
    "MD041": false,
    "MD042": true,
    "MD043": false,
    "MD044": {
      "proper_names": [
        "GitHub",
        "NumPy",
        "Python",
        "Julia",
        "Java",
        "Rust",
        "JavaScript",
        "TypeScript",
        "Docker",
        "Linux",
        "macOS",
        "Windows",
        "Marchenko-Pastur",
        "Tracy-Widom",
        "Keating-Snaith",
        "TinyGPT",
        "BPE",
        "Adam",
        "GELU",
        "LayerNorm",
        "BBP",
        "NHSE",
        "Caputo",
        "RLHF",
        "GPT-2",
        "OpenSSF",
        "CodeQL",
        "Codecov",
        "Zenodo",
        "ORCID",
        "arXiv",
        "PyPI",
        "Mermaid"
      ],
      "code_blocks": false
    },
    "MD045": true,
    "MD046": {
      "style": "fenced"
    },
    "MD047": true,
    "MD048": {
      "style": "backtick"
    },
    "MD049": {
      "style": "asterisk"
    },
    "MD050": {
      "style": "asterisk"
    },
    "MD051": false,
    "MD052": true,
    "MD053": {
      "bulleted": true,
      "numbered": false
    },
    "MD054": false,
    "MD055": {
      "style": "leading_and_trailing"
    },
    "MD058": false,
    "MD059": false,
    "MD060": false
  },
  "globs": [
    "**/*.md",
    "!CHANGELOG.md",
    "!laboratory/webapp/**",
    "!docs/site/**",
    "!node_modules/**",
    "!**/.git/**",
    "!**/.venv/**",
    "!**/results/**"
  ],
  "overrides": [
    {
      "filter": [
        "README.md"
      ],
      "combine": "merge",
      "config": {
        "MD001": false,
        "MD042": false
      }
    }
  ]
}
