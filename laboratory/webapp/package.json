{
  "name": "rmt-llm-laboratory-webapp",
  "version": "1.0.0",
  "description": "RMT-LLM Laboratory — Real-time visualization web app (CRA + Socket.io equivalent)",
  "author": "Iskhak Hamzatovich Isaev",
  "license": "Proprietary — All rights reserved",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "server": "node server/server.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "start:prod": "NODE_ENV=production node server/server.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5",
    "socket.io": "^4.7.5",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "recharts": "^2.12.7",
    "plotly.js-dist-min": "^2.34.0",
    "react-plotly.js": "^2.6.0",
    "lucide-react": "^0.395.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0",
    "framer-motion": "^13.1.0",
    "zustand": "^4.5.2",
    "axios": "^1.7.2",
    "@tanstack/react-query": "^5.45.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.1",
    "concurrently": "^8.2.2",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
